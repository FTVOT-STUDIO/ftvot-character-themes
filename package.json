{
  "name": "pore-theme",
  "displayName": "Pore Theme",
  "description": "Gothic pastel color themes from Pore and Malkuth illustrations, with built-in per-theme background art that switches instantly with the theme.",
  "version": "2.2.1",
  "publisher": "ftvot-studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FTVOT-STUDIO/pore-theme"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "background",
    "dark",
    "gothic",
    "light",
    "malkuth",
    "pastel",
    "pink",
    "pore",
    "purple",
    "snow",
    "theme",
    "winter"
  ],
  "galleryBanner": {
    "color": "#1C1222",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Pore Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/pore-dark-color-theme.json"
      },
      {
        "label": "Pore Light",
        "uiTheme": "vs",
        "path": "./themes/pore-light-color-theme.json"
      },
      {
        "label": "Pore Snow Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/pore-snow-dark-color-theme.json"
      },
      {
        "label": "Pore Snow Light",
        "uiTheme": "vs",
        "path": "./themes/pore-snow-light-color-theme.json"
      },
      {
        "label": "Malkuth Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/malkuth-dark-color-theme.json"
      },
      {
        "label": "Malkuth Light",
        "uiTheme": "vs",
        "path": "./themes/malkuth-light-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "poreTheme.setBackground",
        "title": "현재 테마에 배경 이미지 지정",
        "category": "Pore Theme"
      },
      {
        "command": "poreTheme.clearBackground",
        "title": "현재 테마의 배경 이미지 제거",
        "category": "Pore Theme"
      },
      {
        "command": "poreTheme.removePatch",
        "title": "배경 기능 끄기 (VS Code 원본 복구)",
        "category": "Pore Theme"
      }
    ],
    "configuration": {
      "title": "Pore Theme",
      "properties": {
        "poreTheme.backgrounds": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "테마 이름별 배경 이미지 경로. 예: `{ \"Pore Snow Dark\": \"C:/Users/me/Pictures/snow.png\" }`. 처음 설치하면 Snow/Malkuth 테마에 동봉 이미지가 자동으로 지정됩니다. 테마를 바꾸면 리로드 없이 즉시 전환되고, 이 목록이 바뀔 때만 한 번 다시 로드합니다. VS Code 내장 테마나 다른 확장 테마의 이름도 쓸 수 있습니다."
        },
        "poreTheme.background.opacity": {
          "type": "number",
          "default": 0.08,
          "minimum": 0,
          "maximum": 1,
          "description": "배경 이미지 불투명도. 0.06~0.12 권장."
        },
        "poreTheme.background.enabled": {
          "type": "boolean",
          "default": true,
          "description": "테마별 배경 이미지 사용 여부. 끄면 VS Code 원본 파일로 복구합니다."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  }
}
