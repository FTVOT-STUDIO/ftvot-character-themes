      {
        "label": "Pore Snow Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/pore-snow-dark-color-theme.json"
      },
      {
        "label": "Pore Snow Light",
        "uiTheme": "vs",
        "path": "./themes/pore-snow-light-color-theme.json"
