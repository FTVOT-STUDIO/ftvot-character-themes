  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8B90BB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#B39CE6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CDA8D0"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E3A6D4"
      }
    },
    {
      "name": "Regex",
