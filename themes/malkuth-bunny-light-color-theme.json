      "settings": {
        "foreground": "#8F3488"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#6A4D0F"
      }
    },
    {
      "name": "Number",
