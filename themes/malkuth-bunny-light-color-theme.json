  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#554A76",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#6E3DA6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#84387E"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.placeholder"
