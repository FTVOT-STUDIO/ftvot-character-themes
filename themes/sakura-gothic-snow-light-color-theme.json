  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7E4466",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#9E2C66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9A3D67"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#B3125A"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7E5000"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B0263F"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#7E5000"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package"
      ],
      "settings": {
        "foreground": "#B3125A"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8E3570",
        "fontStyle": ""
      }
    },
    {
      "name": "Keyword operator words",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#B3125A"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9E2C66"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5A44B8"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.type",
        "storage.type.cs",
        "storage.type.kotlin"
      ],
      "settings": {
        "foreground": "#3F48A8"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6A3CA6"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#6A3A58"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#4A0F2A"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#6A2C55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#B3125A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.variable.field",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7A3466"
      }
    },
    {
      "name": "Decorator / Attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#A0306A"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#A0306A"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.macro"
      ],
      "settings": {
        "foreground": "#7E5000"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#734A62"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#B3125A"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#80338A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#5A44B8",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value"
      ],
      "settings": {
        "foreground": "#9A3D67"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#B0263F"
      }
    },
    {
      "name": "JSON key 1",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#B3125A"
      }
    },
    {
      "name": "JSON key 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5A44B8"
      }
    },
    {
      "name": "JSON key 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3F48A8"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#B3125A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#9E2C66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#7E5000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9A3D67"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
