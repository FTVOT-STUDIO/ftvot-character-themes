        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6A3A58",
    "class": "#6A3CA6",
    "struct": "#6A3CA6",
    "interface": {
      "foreground": "#6A3CA6",
      "italic": true
    },
    "enum": "#6A3CA6",
    "enumMember": "#7E5000",
    "typeParameter": {
      "foreground": "#3F48A8",
      "italic": true
    },
    "type": "#3F48A8",
    "function": "#5A44B8",
    "method": "#5A44B8",
    "macro": "#7E5000",
    "property": "#7A3466",
    "field": "#7A3466",
    "event": "#A0306A",
    "parameter": {
      "foreground": "#6A2C55",
      "italic": true
    },
    "variable": "#4A0F2A",
    "variable.readonly": "#7E5000",
    "property.readonly": "#7E5000",
    "variable.defaultLibrary": "#7E5000",
    "keyword": "#B3125A",
    "decorator": "#A0306A",
    "annotation": "#A0306A",
    "label": "#74365A",
    "*.deprecated": {
      "strikethrough": true
    }
  }
