        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#F7C1DC"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#BFA8FF"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B9A3C2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#FF6FAE"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8CCFB0"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5C7A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#BFA8FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5C7A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F2C46D",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#D3BCDD",
    "class": "#C9B6FF",
    "struct": "#C9B6FF",
    "interface": {
      "foreground": "#C9B6FF",
      "italic": true
    },
    "enum": "#C9B6FF",
    "enumMember": "#E4A6F0",
    "typeParameter": {
      "foreground": "#9FB0FF",
      "italic": true
    },
    "type": "#9FB0FF",
    "function": "#BFA8FF",
    "method": "#BFA8FF",
    "macro": "#E4A6F0",
    "property": "#D7B8E8",
    "field": "#D7B8E8",
    "event": "#F4A6CF",
    "parameter": {
      "foreground": "#E2C7EC",
      "italic": true
    },
    "variable": "#EEDFF2",
    "variable.readonly": "#E4A6F0",
    "property.readonly": "#E4A6F0",
    "variable.defaultLibrary": "#E4A6F0",
    "keyword": "#FF6FAE",
    "decorator": "#F4A6CF",
    "annotation": "#F4A6CF",
    "label": "#B9A3C2",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
