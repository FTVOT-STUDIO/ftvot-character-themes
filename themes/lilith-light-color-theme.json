  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5F4466",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#6C3AA6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
