  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6C5474",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#B0306F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9B3A6B"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8E3A9E"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#8E3A9E"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8A3E8E",
        "fontStyle": ""
      }
    },
    {
      "name": "Keyword operator words",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B0306F"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5B3FB5"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.type",
        "storage.type.cs",
        "storage.type.kotlin"
      ],
      "settings": {
        "foreground": "#3F51B5"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6A3FB0"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#5E4466"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2A1430"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#5E3468",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#C2186B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.variable.field",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6E3C7E"
      }
    },
    {
      "name": "Decorator / Attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#A8326E"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#A8326E"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.macro"
      ],
      "settings": {
        "foreground": "#8E3A9E"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#6F5878"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7A3FA0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#5B3FB5",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value"
      ],
      "settings": {
        "foreground": "#9B3A6B"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "JSON key 1",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "JSON key 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5B3FB5"
      }
    },
    {
      "name": "JSON key 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3F51B5"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#C2186B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#B0306F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8E3A9E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9B3A6B"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5B3FB5"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5E4466",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#C2186B"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#256A4C"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B81D42"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#5B3FB5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B81D42"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#835200",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5E4466",
    "class": "#6A3FB0",
    "struct": "#6A3FB0",
    "interface": {
      "foreground": "#6A3FB0",
      "italic": true
    },
    "enum": "#6A3FB0",
    "enumMember": "#8E3A9E",
    "typeParameter": {
      "foreground": "#3F51B5",
      "italic": true
    },
    "type": "#3F51B5",
    "function": "#5B3FB5",
    "method": "#5B3FB5",
    "macro": "#8E3A9E",
    "property": "#6E3C7E",
    "field": "#6E3C7E",
    "event": "#A8326E",
    "parameter": {
      "foreground": "#5E3468",
      "italic": true
    },
    "variable": "#2A1430",
    "variable.readonly": "#8E3A9E",
    "property.readonly": "#8E3A9E",
    "variable.defaultLibrary": "#8E3A9E",
    "keyword": "#C2186B",
    "decorator": "#A8326E",
    "annotation": "#A8326E",
    "label": "#5E4466",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
